menu "CherryUSB Driver"

config BSP_CHERRYUSB_DEVICE_DEFAULT_DWC2_ST
    bool
    default y if BSP_USING_USB_CDC || BSP_USING_USB_MSC || BSP_USING_USB_CDC_MSC || BSP_USING_USB_HID || BSP_USING_USB_CDC_HID || BSP_USING_USB_MSC_HID

choice
    prompt "USB Device Mode"
    default BSP_USB_DEVICE_NONE

config BSP_USB_DEVICE_NONE
    bool "Disabled"

config BSP_USING_USB_CDC
    bool "CDC only (Virtual Serial Port)"
    depends on !BSP_USING_USBD
    select RT_USING_CHERRYUSB
    select RT_CHERRYUSB_DEVICE
    select RT_CHERRYUSB_DEVICE_CDC_ACM
    help
        Enable CherryUSB CDC ACM device mode only. A virtual serial port
        (COM) will be available for communication.

config BSP_USING_USB_HID
    bool "HID only (Custom HID Device)"
    depends on !BSP_USING_USBD
    select RT_USING_CHERRYUSB
    select RT_CHERRYUSB_DEVICE
    select RT_CHERRYUSB_DEVICE_HID
    help
        Enable CherryUSB HID device mode only. A custom HID device with
        IN+OUT interrupt endpoints will be available for generic data
        transfer. Suitable for custom communication protocols.

config BSP_USING_USB_MSC
    bool "MSC only (SD card as U-disk)"
    depends on !BSP_USING_USBD
    select RT_USING_CHERRYUSB
    select RT_CHERRYUSB_DEVICE
    select RT_CHERRYUSB_DEVICE_MSC
    select BSP_USING_SDIO
    help
        Enable CherryUSB MSC device mode only. The SD card will appear
        as a removable disk on the connected computer.

config BSP_USING_USB_CDC_MSC
    bool "CDC+MSC (Virtual Serial Port + SD card as U-disk)"
    depends on !BSP_USING_USBD
    select RT_USING_CHERRYUSB
    select RT_CHERRYUSB_DEVICE
    select RT_CHERRYUSB_DEVICE_CDC_ACM
    select RT_CHERRYUSB_DEVICE_MSC
    select BSP_USING_SDIO
    help
        Enable CherryUSB CDC+MSC composite device. The SD card will appear
        as a removable disk, and a virtual serial port (COM) will also be
        available for communication.

config BSP_USING_USB_CDC_HID
    bool "CDC+HID (Virtual Serial Port + Custom HID)"
    depends on !BSP_USING_USBD
    select RT_USING_CHERRYUSB
    select RT_CHERRYUSB_DEVICE
    select RT_CHERRYUSB_DEVICE_CDC_ACM
    select RT_CHERRYUSB_DEVICE_HID
    help
        Enable CherryUSB CDC+HID composite device. A virtual serial port
        (COM) and a custom HID device will be available simultaneously.
        The HID device can be used for custom data exchange with the host.

config BSP_USING_USB_MSC_HID
    bool "MSC+HID (SD card as U-disk + Custom HID)"
    depends on !BSP_USING_USBD
    select RT_USING_CHERRYUSB
    select RT_CHERRYUSB_DEVICE
    select RT_CHERRYUSB_DEVICE_MSC
    select RT_CHERRYUSB_DEVICE_HID
    select BSP_USING_SDIO
    help
        Enable CherryUSB MSC+HID composite device. The SD card will appear
        as a removable disk, and a custom HID device will also be available
        for custom data exchange with the host.

endchoice

if BSP_USING_USB_MSC || BSP_USING_USB_CDC_MSC || BSP_USING_USB_MSC_HID

config BSP_USB_MSC_BLOCK_DEV_NAME
    string "Block device name for USB MSC"
    default "sd0"
    help
        The RT-Thread block device name to expose via USB MSC.
        Default is "sd0" which corresponds to the SD card via SDIO.

config BSP_USB_MSC_READ_ONLY
    bool "Mount as read-only U-disk"
    default n
    help
        If enabled, the USB MSC device will be read-only on the host PC side.
        This prevents accidental data corruption from the host while the
        SD card may also be mounted locally.

endif

endmenu
